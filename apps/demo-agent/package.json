{
  "name": "@agentgate/demo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "pnpm --filter \"@agentgate/demo-agent^...\" build && tsc -p tsconfig.test.json",
