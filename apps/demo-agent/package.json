  "dependencies": {
    "@agentgate/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
