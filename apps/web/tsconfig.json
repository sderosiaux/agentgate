{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next compiles this tree itself, so the module settings describe what the bundler
    // understands rather than what node would: the rest of the repo stays on NodeNext.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "incremental": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  // `.next-canary` is where the client-bundle test builds. Listed here even though nothing
  // depends on it, because `next build` appends its own generated types directory to this file
  // when it is absent — and a test run that edits a tracked source file leaves the working tree
  // dirty for no reason anyone can see.
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next-canary/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-canary"]
}
