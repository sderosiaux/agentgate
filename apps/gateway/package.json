{
  "name": "@agentgate/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter \"@agentgate/gateway^...\" build && tsc -p tsconfig.test.json",
    "test": "pnpm --filter \"@agentgate/gateway^...\" build && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@agentgate/auth": "workspace:*",
    "@agentgate/policy": "workspace:*",
    "@agentgate/shared": "workspace:*",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentgate/mock-github": "workspace:*",
    "@types/node": "^22.19.2",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "openapi-types": "^12.1.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
