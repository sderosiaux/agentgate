generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Principal {
  id       String    @id // pri_xxx
  name     String
  agents   Agent[]
  missions Mission[]
}

model Agent {
  id          String    @id // agt_xxx
  principalId String
  agentType   String // codex | claude-code | ci | custom
  createdAt   DateTime  @default(now())
  principal   Principal @relation(fields: [principalId], references: [id])
  missions    Mission[]
}

model Mission {
  id          String    @id // mis_xxx
  principalId String
  agentId     String
  intent      String
  status      String    @default("active") // active | expired | revoked
  /// A free-form label the issuer chose, shown in the console and passed to the policy engine
  /// as `mission.label`. Deliberately NOT called `environment`: the deployment a decision is
  /// made in comes from the gateway's own configuration, and a mission that could name it
  /// would be a mission that could talk its way out of an environment-scoped rule.
  label       String    @default("development")
  permissions Json // MissionPermissions
  network     Json // NetworkRules
  limits      Json // MissionLimits
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  principal   Principal @relation(fields: [principalId], references: [id])
  agent       Agent     @relation(fields: [agentId], references: [id])
}

model Credential {
  id              String @id // cred_xxx
  alias           String @unique // github_work
  provider        String // github
  logicalHost     String // api.github.com
  upstreamBaseUrl String // http://mock-github:3001 (demo)
  injection       Json // {type:"header",name:"Authorization",format:"Bearer {value}"}
  ciphertext      Bytes // AES-256-GCM: iv(12) || tag(16) || data
  status          String @default("active")
}

model Approval {
  id             String    @id // apr_xxx
  missionId      String
  agentId        String
  resource       String
  action         String
  /// sha256 over (method, host, normalized path, body hash) — the request a human was shown.
  /// A grant is spendable only on a request that hashes to this, so "approve the merge of pull
  /// request 7" cannot be spent on pull request 9. See `requestBindingHash` in approvals/service.ts.
  requestHash    String
  requestSummary Json // {method, host, path, bodySize, bodyHash, contentType}
  reason         String
  status         String    @default("pending") // pending | approved | denied | expired | consumed
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  /// Who decided. A shared admin token names no human by itself, so the management API
  /// takes it from the caller: an approval nobody is attached to is not an approval.
  decidedBy      String?
  grantExpiresAt DateTime?
  consumedAt     DateTime?

  // The two lookups that exist: the pipeline asking whether this mission already has a
  // pending approval for what it is about to refuse, and the management list by status.
  @@index([missionId, status])

  // NOT the whole story: a partial unique index on
  // (missionId, agentId, resource, action, requestHash) WHERE status = 'pending' lives in
  // migration 20260812093000_approval_request_binding, because Prisma has no schema spelling
  // for one. It is what stops a burst of retries opening one approval each — do not let
  // `migrate dev` drop it as drift.
}

model AuditEvent {
  id            String   @id // aud_xxx
  requestId     String // req_xxx
  timestamp     DateTime @default(now())
  principalId   String?
  agentId       String?
  missionId     String?
  resource      String?
  action        String?
  method        String?
  destHost      String?
  destPath      String?
  decision      String // ALLOW | DENY | REQUIRE_APPROVAL | ERROR
  reason        String
  matchedPolicy String?
  approvalId    String?
  httpStatus    Int?
  latencyMs     Int
  bodySize      Int?
  bodyHash      String?
  contentType   String?
  /// The PolicyInput the engine was actually asked, for the runtime-decision view. Null on
  /// every attempt refused before the engine was reached. Redacted by construction: no
  /// headers, no body, no credential — see `audit/recorder.ts`.
  policyInputSnapshot Json?

  @@index([missionId, timestamp])
  @@index([decision, timestamp])
  // The management audit list filters on these too, and `GET /decisions/:requestId` is a
  // lookup by request id on a table that only ever grows.
  @@index([agentId, timestamp])
  @@index([principalId, timestamp])
  @@index([requestId])
}

/// What the gateway was about to do, written before it did it.
///
/// `AuditEvent` is written in a `finally`, which is after the upstream has already acted. If
/// that write fails — the one table-specific failure the rest of the gateway survives — the
/// caller sees a 500 for a request that succeeded, retries, and does it twice. Nothing recorded
/// the first attempt.
///
/// This is the pre-forward half. One row per attempt that reached an upstream, written and
/// awaited before the request leaves, correlated with the outcome by `requestId`. A row here
/// with no matching `AuditEvent` is a request that was sent and whose result nobody recorded:
///
///   SELECT f.* FROM "ForwardIntent" f
///   LEFT JOIN "AuditEvent" a ON a."requestId" = f."requestId"
///    WHERE a."id" IS NULL;
///
/// Deliberately a second table rather than a second `AuditEvent` row. The trail's contract is
/// exactly one row per attempt (D12) and its triggers refuse every UPDATE, so an outcome cannot
/// be appended to an existing row and a second row would make every count of the trail wrong.
model ForwardIntent {
  id              String   @id // fwi_xxx
  requestId       String   @unique // req_xxx — the join key with AuditEvent
  timestamp       DateTime @default(now())
  principalId     String
  agentId         String
  missionId       String
  resource        String
  action          String
  method          String
  destHost        String
  destPath        String
  /// Metadata about the body, never the body (D10) — as in the trail.
  bodyHash        String?
  /// Which key was about to be injected, by name. Never the value behind it.
  credentialAlias String
  /// The grant this attempt spent, if any. A consumed one-time approval whose outcome was lost
  /// is the case that most needs somebody to look at it.
  approvalId      String?

  @@index([timestamp])
  @@index([missionId, timestamp])
}

model UsageCounter {
  missionId    String @id
  requestCount Int    @default(0)
  bytesTotal   BigInt @default(0)
}

model RateWindow {
  missionId String
  minute    DateTime // truncated to the minute
  count     Int      @default(0)

  @@id([missionId, minute])
}
