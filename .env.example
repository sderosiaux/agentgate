# ============================================================================
# DEV-ONLY VALUES — DO NOT USE IN ANY REAL DEPLOYMENT.
# Every secret below is committed to the repository on purpose, so that
# `cp .env.example .env && docker compose up --build` works out of the box.
# For anything beyond the local demo, run: node scripts/generate-env.mjs
# ============================================================================

DATABASE_URL=postgresql://agentgate:agentgate@postgres:5432/agentgate

# Same PostgreSQL instance reached from the host (the gateway runs inside compose,
# `pnpm -r test` runs outside it) but a separate database: audit rows are
# append-only by design, so test rows would pile up in the demo data forever.
# `make db-migrate` creates it on first run. Keep the port in sync with POSTGRES_PORT.
DATABASE_URL_TEST=postgresql://agentgate:agentgate@localhost:5432/agentgate_test

# AES-256-GCM key protecting stored credentials (base64, 32 bytes). DEV-ONLY.
AGENTGATE_MASTER_KEY=K2JPcgtcZ4ukPj98a1tgcKpNuopMlsvec48oyCz4ynM=

# Ed25519 keypair signing the agent JWTs (base64 PKCS8 / SPKI DER). DEV-ONLY.
AGENTGATE_JWT_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIHcxm+pVfmfHfsi4KHeKy7kYixbLC6oSPTXwjLW/HgL1
AGENTGATE_JWT_PUBLIC_KEY=MCowBQYDK2VwAyEA+PGqiz7+4VXQkMd1WL/BfPxi9FJxG8bgUYzl5ysYXQ8=

# Single admin token guarding the management API. At least 16 characters: the log
# scrubber ignores shorter values, so a short one could never be redacted. DEV-ONLY.
ADMIN_TOKEN=dev-admin-token-DEV-ONLY

# The credential the demo agent must never see: it is injected by the gateway
# and only the mock GitHub service knows it. Demo fixture, not a real secret.
MOCK_GITHUB_TOKEN=super-secret-github-token

# Host ports the stack is published on. Change them if they are already taken.
GATEWAY_PORT=8080
POSTGRES_PORT=5432

# builtin (default) or opa. With opa, the gateway needs OPA_URL and refuses to
# boot without it. Compose injects OPA_URL=http://opa:8181 for the gateway
# container; set it here only for host-side runs (e.g. http://127.0.0.1:8181).
POLICY_ENGINE=builtin
ENVIRONMENT=development

# --- the demo (`make demo`, `make demo-host`) ---------------------------------
# Approve the case-4 pull request automatically, two seconds after the agent asks,
# so the demo runs unattended. Off for anything but 1/true/yes/on; unset means on.
# Turn it off to approve by hand in the console instead.
DEMO_AUTO_APPROVE=1

# The knobs below are read from the environment, not from this file, and are listed
# here to be discoverable. Uncomment at your own risk — a value set here applies to
# every run, which is rarely what you want.
#
#   DEMO_MODE               `host` runs the demo as local processes instead of
#                           containers. IGNORED in this file on purpose: the mode
#                           comes from the make target (`make demo` vs
#                           `make demo-host`), so a stray line here cannot silently
#                           turn the container demo into a host one.
#   DEMO_GATEWAY_PORT       host-mode gateway port (default 8099). The orchestrator
#                           refuses to start if it is already taken.
#   DEMO_MOCK_GITHUB_PORT   host-mode mock GitHub port (default 3001).
#   DEMO_VERBOSE=1          print the stdout of the services host mode starts.
#   DEMO_SCAN_ROOT          where case 2 scans for the upstream token. Defaults to
#                           /app in the container and to the agent's own directory
#                           on the host — which is narrower, and is why the
#                           container run is the one that proves anything.
#   AGENTGATE_WEB_URL       the console address the agent prints next to a pending
#                           approval (default http://localhost:${WEB_PORT:-3000}).
