# ============================================================================
# DEV-ONLY VALUES — DO NOT USE IN ANY REAL DEPLOYMENT.
# Every secret below is committed to the repository on purpose, so that
# `cp .env.example .env && docker compose up --build` works out of the box.
# For anything beyond the local demo, run: node scripts/generate-env.mjs
# ============================================================================

DATABASE_URL=postgresql://agentgate:agentgate@postgres:5432/agentgate

# Same database, reached from the host: the gateway runs inside compose,
# `pnpm -r test` runs outside it.
DATABASE_URL_TEST=postgresql://agentgate:agentgate@localhost:5432/agentgate

# AES-256-GCM key protecting stored credentials (base64, 32 bytes). DEV-ONLY.
AGENTGATE_MASTER_KEY=K2JPcgtcZ4ukPj98a1tgcKpNuopMlsvec48oyCz4ynM=

# Ed25519 keypair signing the agent JWTs (base64 PKCS8 / SPKI DER). DEV-ONLY.
AGENTGATE_JWT_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIHcxm+pVfmfHfsi4KHeKy7kYixbLC6oSPTXwjLW/HgL1
AGENTGATE_JWT_PUBLIC_KEY=MCowBQYDK2VwAyEA+PGqiz7+4VXQkMd1WL/BfPxi9FJxG8bgUYzl5ysYXQ8=

# Single admin token guarding the management API. DEV-ONLY.
ADMIN_TOKEN=dev-admin-token

# The credential the demo agent must never see: it is injected by the gateway
# and only the mock GitHub service knows it. Demo fixture, not a real secret.
MOCK_GITHUB_TOKEN=super-secret-github-token

POLICY_ENGINE=builtin
ENVIRONMENT=development
DEMO_AUTO_APPROVE=1
