{
  "name": "@agentgate/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter \"@agentgate/sdk^...\" build && tsc -p tsconfig.test.json",
    "test": "pnpm --filter \"@agentgate/sdk^...\" build && vitest run"
  },
  "devDependencies": {
    "@agentgate/auth": "workspace:*",
    "@agentgate/gateway": "workspace:*",
    "@agentgate/mock-github": "workspace:*",
    "@agentgate/policy": "workspace:*",
    "@agentgate/shared": "workspace:*",
    "@types/node": "^22.19.2",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
